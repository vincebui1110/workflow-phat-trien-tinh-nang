# ENV.sh.example — bản mẫu. Copy thành ~/.claude/ENV.sh rồi sửa 1 dòng SHOPIFY_APP_DIR.
#
# Mọi resolver (backlog-files.sh, roadmap-files.sh) đều `source ~/.claude/ENV.sh`,
# nên KHÔNG hardcode path tuyệt đối ở bất cứ đâu khác. Đổi máy = sửa đúng file này.

export CLAUDE_DIR="$HOME/.claude"

# ⬇️ SỬA DÒNG NÀY cho khớp máy anh (thư mục chứa 6 repo app Avada)
export SHOPIFY_APP_DIR="$HOME/dev/Shopify app"

# App codebases — Flow 0 map app_code → repo path qua đây
export CB_DIR="$SHOPIFY_APP_DIR/cookie-bar"
export OL_DIR="$SHOPIFY_APP_DIR/order-limit"
export AC_DIR="$SHOPIFY_APP_DIR/accessibility"
export AV_DIR="$SHOPIFY_APP_DIR/age-verification"
export SFF_DIR="$SHOPIFY_APP_DIR/sea-fraud-filter"
export WF_DIR="$SHOPIFY_APP_DIR/withdrawal-forms"

# Map dự án CANONICAL — 1 nguồn sự thật cho cả 2 resolver.
# Chỉ liệt kê dự án CÓ trên máy này.
export PROJECT_DIRS="SYS=$CLAUDE_DIR;APP=$SHOPIFY_APP_DIR;CB=$CB_DIR;OL=$OL_DIR;AC=$AC_DIR;AV=$AV_DIR;FF=$SFF_DIR;WF=$WF_DIR"

export BRIEF_DOC_FILENAME="BRIEF.md"
export BRIEF_DOC_SUBDIR="docs"
export LOOPTASKS_FILENAME="LOOPTASKS.md"
export LOOPTASKS_DIRS="$PROJECT_DIRS"
